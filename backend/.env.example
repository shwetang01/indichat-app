PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/indichat?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration (Media & Avatar uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Email OTP Service
BREVO_API_KEY=your_brevo_api_key
BREVO_VERIFIED_SENDER=your_verified_sender_email@domain.com

# Twilio SMS OTP Service
TWILLO_ACCOUNT_SID=your_twilio_account_sid
TWILLO_AUTH_TOKEN=your_twilio_auth_token
TWILLO_SERVICE_SID=your_twilio_verify_service_sid
